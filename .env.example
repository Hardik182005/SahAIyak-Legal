# SahAIyak — Environment Variables
# Copy to .env and fill in your values

# ── AI APIs ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Pinecone (vector search) ─────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_HOST=https://your-index-host.svc.pinecone.io
PINECONE_INDEX=sahayak-judgments

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local dev:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sahayak
# Production (Cloud SQL):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<cloud-sql-ip>/sahayak

# ── Cache (Redis) ────────────────────────────────────────────────────────────
# Local dev:
REDIS_URL=redis://localhost:6379
# Production (Memorystore):
# REDIS_URL=redis://<memorystore-ip>:6379

# ── App Settings ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
DATA_RETENTION_DAYS=30

# ── GCP (for Cloud Run / Vertex AI embeddings) ───────────────────────────────
GOOGLE_CLOUD_PROJECT=sahaiyak
GCS_ZIP_URI=gs://sahaiyak/archive.zip
